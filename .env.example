PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx
# fast ($1/1k req) | web ($5/1k req)
PERPLEXITY_SEARCH_TYPE=fast
PERPLEXITY_MAX_RESULTS=20
PERPLEXITY_MAX_TOKENS_PER_PAGE=256
# optional, e.g. KR
PERPLEXITY_COUNTRY=
# Vercel AI Gateway (query expansion + related searches)
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5
DECISION_MODEL=typesafe-ai/jev
# Optional tie-breaker / fallback scorer, e.g. voyage/rerank-3. Empty = off
RERANK_MODEL=
# AI search (plan → search → review → write). Providers go to providerOptions.gateway.only
RESEARCH_MODEL=deepseek/deepseek-v4.1-flash
RESEARCH_PROVIDERS=morph,runware
# sqlite file for search history
DATABASE_PATH=data/search.db
